{
  "manifest_version": 3,
  "name": "PSA Fetch",
  "version": "2.2.0",
  "description": "Intercepts PSA torrent redirects and opens a real-time RSS feed for HEVC-PSA releases — no extra clicks, no ads.",
  "permissions": [
    "clipboardWrite",
    "storage",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "*://*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "PSA Fetch Settings",
    "default_icon": {
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://*/*"
      ],
      "include_globs": [
        "*://psa.*/*",
        "*://*.psa.*/*",
        "*://psarip.*/*",
        "*://*.psarip.*/*",
        "*://*psa-rip*/*",
        "*://*psarips*/*",
        "*://*hevc-psa*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*/*"
      ],
      "include_globs": [
        "*://*bt4g*/*",
        "*://*/*page=rss*"
      ],
      "js": [
        "rss.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
